{
  "name": "claudeexplainatory",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "explain": "./bin/reel.mjs",
    "reel": "./bin/reel.mjs"
  },
  "scripts": {
    "explain": "node bin/reel.mjs",
    "reel": "node bin/reel.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "python3 tools/smoke_test.py",
    "test:hyperframes": "node tools/hyperframes_smoke.mjs",
    "test:editorial": "node tools/editorial_hyperframes_smoke.mjs",
    "test:draft": "node tools/editorial_draft_smoke.mjs",
    "doctor": "node bin/reel.mjs doctor",
    "style-scan": "python3 tools/style_scan.py assets/references",
    "test:real-audio": "node tools/real_audio_smoke.mjs",
    "test:diagram": "node tools/diagram_hyperframes_smoke.mjs",
    "test:bars": "node tools/kinetic_bars_smoke.mjs",
    "test:scene-graph": "node tools/scene_graph_smoke.mjs",
    "direct:graph": "node bin/direct-graph.mjs",
    "test:puppets": "node tools/puppet_rig_smoke.mjs",
    "assets:build": "node tools/build_art_pack.mjs",
    "test:illustrated": "node tools/illustrated_village_smoke.mjs"
  },
  "dependencies": {
    "gsap": "^3.14.2",
    "hyperframes": "^0.9.37",
    "three": "^0.181.0"
  }
}
